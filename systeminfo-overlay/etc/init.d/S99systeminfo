#!/bin/sh

PIDFILE="/var/run/systeminfo.pid"
PROGRAM="/usr/bin/systeminfo.py"

start() {
    printf "Starting systeminfo: "

    if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
        echo "already running"
        return 0
    fi

    /usr/bin/python3 "$PROGRAM" > /var/log/systeminfo.log 2>&1 &
    echo $! > "$PIDFILE"
    echo "OK"
}

stop() {
    printf "Stopping systeminfo: "

    if [ ! -f "$PIDFILE" ]; then
        echo "not running"
        return 0
    fi

    kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
    echo "OK"
}

case "$1" in
    start)
        start
        ;;
    stop)
        stop
        ;;
    restart)
        stop
        start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit $?
