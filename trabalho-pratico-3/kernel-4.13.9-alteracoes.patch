From 9be15840013065a09df2df4c5347ed7b944c9633 Mon Sep 17 00:00:00 2001
From: afisch16 <a.fisch@edu.pucrs.br>
Date: Wed, 4 Nov 2026 01:23:31 +0000
Subject: [PATCH 3/4] Prioriza tarefas acima de SCHED_LOW_IDLE

---
 kernel/sched/fair.c | 38 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/kernel/sched/fair.c b/kernel/sched/fair.c
index 8e89bc22..ccfdd5a6 100644
--- a/kernel/sched/fair.c
+++ b/kernel/sched/fair.c
@@ -3890,6 +3890,41 @@ set_next_entity(struct cfs_rq *cfs_rq, struct sched_entity *se)
 static int
 wakeup_preempt_entity(struct sched_entity *curr, struct sched_entity *se);
 
+/*
+ * Se o CFS escolher LOW_IDLE, procura uma tarefa pronta com outra política.
+ * Entre as candidatas, mantém a escolha pelo menor tempo virtual.
+ */
+static struct sched_entity *
+prefer_non_low_idle(struct cfs_rq *cfs_rq, struct sched_entity *curr,
+		    struct sched_entity *selected)
+{
+	struct sched_entity *candidate;
+	struct sched_entity *best = NULL;
+
+	/* A busca só é necessária quando a tarefa escolhida é LOW_IDLE. */
+	if (!selected || !entity_is_task(selected) ||
+	    !idle_low_policy(task_of(selected)->policy))
+		return selected;
+
+	/* A tarefa atual pode estar pronta, mesmo fora da árvore de espera. */
+	if (curr && curr->on_rq && entity_is_task(curr) &&
+	    !idle_low_policy(task_of(curr)->policy))
+		best = curr;
+
+	/* Procura na árvore tarefas prontas de outras políticas. */
+	for (candidate = __pick_first_entity(cfs_rq); candidate;
+	     candidate = __pick_next_entity(candidate)) {
+		if (!entity_is_task(candidate) ||
+		    idle_low_policy(task_of(candidate)->policy))
+			continue;
+
+		if (!best || entity_before(candidate, best))
+			best = candidate;
+	}
+
+	/* Mantém LOW_IDLE somente quando não encontrou outra candidata. */
+	return best ? best : selected;
+}
 /*
  * Pick the next process, keeping these things in mind, in this order:
  * 1) keep things fair between processes/task groups
@@ -3943,6 +3978,9 @@ pick_next_entity(struct cfs_rq *cfs_rq, struct sched_entity *curr)
 	if (cfs_rq->next && wakeup_preempt_entity(cfs_rq->next, left) < 1)
 		se = cfs_rq->next;
 
+	/* Prefere outra política quando LOW_IDLE foi escolhida e há tarefa pronta. */
+	se = prefer_non_low_idle(cfs_rq, curr, se);
+
 	clear_buddies(cfs_rq, se);
 
 	return se;
-- 
2.53.0


