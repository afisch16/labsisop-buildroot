diff --git a/syscall/sleepProcesses.c b/syscall/sleepProcesses.c
new file mode 100644
index 00000000..9ffbe05e
--- /dev/null
+++ b/syscall/sleepProcesses.c
@@ -0,0 +1,82 @@
+#include <linux/kernel.h>
+#include <linux/sched.h>
+#include <linux/sched/signal.h>
+#include <linux/syscalls.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+#include <linux/errno.h>
+#include "sleepProcesses.h"
+
+#define SLEEP_BUFFER_MAX 4096
+
+asmlinkage long sys_listSleepProcesses(char __user *buf, int size)
+{
+    struct task_struct *process;
+    char *kbuf;
+    const char *state_name;
+    long state;
+    int used = 0;
+    int written;
+
+    if (!buf || size <= 0 || size > SLEEP_BUFFER_MAX)
+        return -EINVAL;
+
+    kbuf = kzalloc(size, GFP_KERNEL);
+    if (!kbuf)
+        return -ENOMEM;
+
+    for_each_process(process) {
+        state = process->state;
+
+        if (state != TASK_INTERRUPTIBLE &&
+            state != TASK_UNINTERRUPTIBLE)
+            continue;
+
+        if (state == TASK_INTERRUPTIBLE)
+            state_name = "TASK_INTERRUPTIBLE";
+        else
+            state_name = "TASK_UNINTERRUPTIBLE";
+
+        written = snprintf(
+            kbuf + used,
+            size - used,
+            "Process: %s\n"
+            " PID_Number: %ld\n"
+            " Process State: %ld (%s)\n\n",
+            process->comm,
+            (long)task_pid_nr(process),
+            state,
+            state_name
+        );
+
+        if (written >= size - used) {
+            kfree(kbuf);
+            return -ENOSPC;
+        }
+
+        used += written;
+    }
+
+    if (used == 0) {
+        written = snprintf(
+            kbuf,
+            size,
+            "No sleeping processes found.\n"
+        );
+
+        if (written >= size) {
+            kfree(kbuf);
+            return -ENOSPC;
+        }
+
+        used = written;
+    }
+
+    if (copy_to_user(buf, kbuf, used + 1)) {
+        kfree(kbuf);
+        return -EFAULT;
+    }
+
+    kfree(kbuf);
+    return used;
+}
