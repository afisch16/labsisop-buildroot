diff --git a/syscall/printMessage.c b/syscall/printMessage.c
new file mode 100644
index 00000000..bc527d67
--- /dev/null
+++ b/syscall/printMessage.c
@@ -0,0 +1,20 @@
+#include <linux/kernel.h>
+#include <linux/syscalls.h>
+#include <linux/uaccess.h>
+#include <linux/errno.h>
+#include "printMessage.h"
+
+asmlinkage long sys_printMessage(const char __user *msg)
+{
+        char buf[256];
+        long copied;
+
+        copied = strncpy_from_user(buf, msg, sizeof(buf));
+
+        if (copied < 0 || copied == sizeof(buf))
+                return -EFAULT;
+
+        printk(KERN_INFO "Message: %s\n", buf);
+
+        return 0;
+}
